{
  "manifest_version": 3,
  "name": "Tab Placement",
  "version": "0.0.0.1",
  "version_name": "0.0.0-dev",
  "description": "Opens new tabs next to the current tab and inside its tab group, without reordering restored tabs.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "sessions", "storage"],
  "background": {
    "service_worker": "service_worker.js"
  }
}
